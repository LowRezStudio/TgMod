class StaticMeshComponentFactory extends MeshComponentFactory
    native
    editinlinenew
    collapsecategories
    hidecategories(Object);

var() StaticMesh StaticMesh;

defaultproperties
{
    CollideActors=true
    BlockActors=true
    BlockZeroExtent=true
    BlockNonZeroExtent=true
    BlockRigidBody=true
}