class LightFunction extends Object
    native(Light)
    editinlinenew
    collapsecategories
    hidecategories(Object);

var() const MaterialInterface SourceMaterial;
var() Vector Scale;
var() float DisabledBrightness;

defaultproperties
{
    Scale=(X=1024.0000000,Y=1024.0000000,Z=1024.0000000)
    DisabledBrightness=1.0000000
}