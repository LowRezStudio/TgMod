class ParticleSpriteEmitter extends ParticleEmitter
    native(Particle)
    editinlinenew
    collapsecategories
    hidecategories(Object,Object);

enum EParticleScreenAlignment
{
    PSA_Square,                     // 0
    PSA_Rectangle,                  // 1
    PSA_Velocity,                   // 2
    PSA_TypeSpecific,               // 3
    PSA_MAX                         // 4
};
